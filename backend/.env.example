# Copy to .env locally. Never commit real secrets.
CAREERSYNC_ENVIRONMENT=development
# Default to SQLite for zero-dependency setup (or switch to PostgreSQL when using Docker):
CAREERSYNC_DATABASE_URL=sqlite:///./careersync.db
# CAREERSYNC_DATABASE_URL=postgresql+psycopg://careersync:careersync@localhost:5432/careersync
CAREERSYNC_REDIS_URL=redis://localhost:6379/0
CAREERSYNC_JWT_SECRET=CHANGE_ME_GENERATE_A_RANDOM_SECRET_KEY_AT_LEAST_32_CHARS
CAREERSYNC_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
CAREERSYNC_UPLOAD_DIRECTORY=../career-sync-storage/uploads
CAREERSYNC_SECURE_COOKIES=false
CAREERSYNC_ENABLE_WORKER=false
CAREERSYNC_AUTO_SEED_DEMO_DATA=false
CAREERSYNC_AI_SERVICE_URL=http://localhost:8001
CAREERSYNC_AI_SERVICE_API_KEY=careersync-internal-ai-service-key-dev
