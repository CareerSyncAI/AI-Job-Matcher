# Copy to .env locally. Never commit real secrets.
CAREERSYNC_ENVIRONMENT=development
CAREERSYNC_DATABASE_URL=postgresql+psycopg://careersync:careersync@localhost:5432/careersync
CAREERSYNC_REDIS_URL=redis://localhost:6379/0
CAREERSYNC_JWT_SECRET=replace-with-a-long-random-secret
CAREERSYNC_CORS_ORIGINS=http://localhost:3000
CAREERSYNC_UPLOAD_DIRECTORY=../career-sync-storage/uploads
CAREERSYNC_SECURE_COOKIES=false
CAREERSYNC_ENABLE_WORKER=false
